# QView configuration.
#
# Copy to .env and fill in the real values. .env is gitignored; this file is
# not, so never put a real secret, token, or instance URL in here.
#
# The six variables marked REQUIRED are checked at startup — the process throws
# and exits rather than coming up half-configured. Everything else has the
# default shown.


# ─── Server ──────────────────────────────────────────────────────────────────

# Port the HTTP server listens on. The container publishes this same port.
PORT=3001


# ─── Salesforce ──────────────────────────────────────────────────────────────
#
# A connected app using the OAuth refresh-token flow. QView never sees a user
# password; it exchanges the refresh token for an access token as needed. All
# Salesforce access is server-side — none of these ever reach the browser.

# REQUIRED. Consumer key of the connected app.
SALESFORCE_CLIENT_ID=

# REQUIRED. Consumer secret of the connected app.
SALESFORCE_CLIENT_SECRET=

# REQUIRED. Your org's My Domain URL, no trailing slash.
# e.g. https://yourorg.my.salesforce.com
SALESFORCE_INSTANCE_URL=

# REQUIRED. Refresh token issued to the connected app for the case owner.
SALESFORCE_REFRESH_TOKEN=

# REST API version to call. Default: v61.0
SALESFORCE_API_VERSION=v61.0

# Display name of the case owner, shown in the header and used to decide
# whether a case comment was written by you or by someone else. Default: empty.
SALESFORCE_OWNER_NAME=

# How far back the initial sync reaches for closed cases. Cases closed longer
# ago than this are never pulled. Default: 120
QVIEW_CLOSED_WINDOW_DAYS=120


# ─── Auth ────────────────────────────────────────────────────────────────────

# REQUIRED. The single email address allowed to sign in. Login is email-only:
# submitting exactly this address grants a session. There is no password and no
# second factor, so QView must not be exposed to an untrusted network.
QVIEW_ALLOWED_EMAIL=

# REQUIRED. Random string used to sign the session cookie. Startup fails if it
# is empty. Generate one with: openssl rand -hex 32
SESSION_SECRET=


# ─── Anthropic (AI-suggested replies) ────────────────────────────────────────
#
# Optional as a whole. Leave the token empty and QView runs fine — the suggest
# button is the only thing that stops working.

# Override the API base URL. Set this when going through an internal gateway;
# leave empty for api.anthropic.com. Default: empty (SDK default).
ANTHROPIC_BASE_URL=

# API token. ANTHROPIC_API_KEY is accepted as a fallback name if this is unset.
ANTHROPIC_AUTH_TOKEN=

# Model used for reply suggestions. Default: claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5


# ─── IQS scorecard ───────────────────────────────────────────────────────────
#
# Labels only. These are printed on the scorecard; they do not change any
# calculation. The response-time maths uses the business-hours window
# configured in the Settings page, not these.

# Your stated coverage window. Default: 9:00 AM - 6:00 PM
IQS_COVERAGE_HOURS=9:00 AM - 6:00 PM

# Timezone label for that window. Default: ET
IQS_OWNER_TZ=ET


# ─── Storage and logging ─────────────────────────────────────────────────────

# SQLite database file. The default sits on the /data volume so the cache
# survives a container rebuild — change it only when running outside Docker.
# Default: /data/qview.db
QVIEW_DB_PATH=/data/qview.db

# Log file, appended to in addition to stdout. Same volume, same reasoning.
# Default: /data/qview.log
QVIEW_LOG_FILE=/data/qview.log

# One of: debug, info, warn, error. Default: info
LOG_LEVEL=info
